# Decisões da FASE 13 (PLANO-DE-ACAO.md) — Ceccon, MinhaApi
# Ver tabela de decisões no plano de ação para o racional de cada regra.

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]

#### Indentação (decisão: 4 espaços) ####
indent_size = 4
tab_width = 4

#### Namespace (decisão: file-scoped) ####
csharp_style_namespace_declarations = file_scoped:error

#### Chaves (decisão: linha nova - padrão Allman/C#) ####
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

#### this. explícito (decisão: não usar) ####
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_event = false:error

#### var vs tipo explícito (decisão: var quando óbvio, tipo explícito quando não) ####
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

#### Campos privados (decisão: _camelCase para campos de instância) ####
# Refinamento: campos const/static readonly seguem PascalCase (convencao padrao
# do ecossistema .NET pra "constante nomeada") - e o que ja esta em uso no
# codigo (TamanhoPaginaPadrao, JsonOptions), entao nao muda nada retroativamente.
# So campo privado de INSTANCIA (o caso comum) usa o prefixo _camelCase.

# Nivel 1 (mais especifico, avaliado primeiro): const
dotnet_naming_symbols.campo_privado_const.applicable_kinds = field
dotnet_naming_symbols.campo_privado_const.applicable_accessibilities = private
dotnet_naming_symbols.campo_privado_const.required_modifiers = const

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.campo_privado_const_pascal_case.symbols = campo_privado_const
dotnet_naming_rule.campo_privado_const_pascal_case.style = pascal_case
dotnet_naming_rule.campo_privado_const_pascal_case.severity = error

# Nivel 2: static readonly
dotnet_naming_symbols.campo_privado_static_readonly.applicable_kinds = field
dotnet_naming_symbols.campo_privado_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.campo_privado_static_readonly.required_modifiers = static,readonly

dotnet_naming_rule.campo_privado_static_readonly_pascal_case.symbols = campo_privado_static_readonly
dotnet_naming_rule.campo_privado_static_readonly_pascal_case.style = pascal_case
dotnet_naming_rule.campo_privado_static_readonly_pascal_case.severity = error

# Nivel 3 (o caso geral, avaliado por ultimo): campo de instancia comum
dotnet_naming_symbols.campo_privado_instancia.applicable_kinds = field
dotnet_naming_symbols.campo_privado_instancia.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_rule.campo_privado_instancia_underscore.symbols = campo_privado_instancia
dotnet_naming_rule.campo_privado_instancia_underscore.style = underscore_camel_case
dotnet_naming_rule.campo_privado_instancia_underscore.severity = error

#### Ordem dos usings (decisão: System primeiro, resto agrupado junto) ####
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:error

#### Tamanho máximo de arquivo/método (decisão: sem limite formal) ####
# Fica a criterio do code review, nao travado por analisador.

#### Idioma de nomes (decisão: híbrido) ####
# Termos de dominio (Produto, Nome, Preco, Ativo) em portugues; termos tecnicos
# (Service, Repository, Controller, Command, Filter, Validator) em ingles.
# Nao existe regra de analisador pra isso - e convencao de equipe, documentada
# aqui e no README.md/PLANO-DE-ACAO.md.

#### Outras preferências de estilo úteis (não fazem parte da tabela de decisão,
#### mas evitam ruido de analisador em casos comuns) ####
csharp_prefer_braces = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_require_accessibility_modifiers = always:suggestion

#### Severidade das regras de estilo ####
# Regras de ESTILO (IDE0xxx) sao apenas sugestoes: aparecem como pontinhos cinzas no
# editor, sem sublinhado amarelo e sem quebrar o build. Quebram o build (error) so as
# regras de nomenclatura e de namespace/using definidas acima (decisoes da FASE 13).
# Regras de QUALIDADE (CA/ASP) seguem o AnalysisLevel do Directory.Build.props.
dotnet_analyzer_diagnostic.category-Style.severity = suggestion
